#include "nrf93m1dk_lm20b_nrf54lm20b-pinctrl.dtsi"
#include <zephyr/dt-bindings/regulator/npm13xx.h>

/ {
	leds {
		compatible = "gpio-leds";
		status = "okay";

		led0: led_0 {
			gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};

		led1: led_1 {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};

		led2: led_2 {
			gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		status = "okay";

		button0: button_0 {
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button 0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button 1";
			zephyr,code = <INPUT_KEY_1>;
		};

		button2: button_2 {
			gpios = <&gpio0 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button 2";
			zephyr,code = <INPUT_KEY_2>;
		};
	};

	modem_dcdc: modem_dcdc {
		compatible = "power-domain-gpio";
		enable-gpios = <&gpio1 28 GPIO_ACTIVE_HIGH>;
		#power-domain-cells = <0>;
		startup-delay-us = <100000>; /* wait for 100ms to stabilize dcdc supply */
		off-on-delay-us = <500000>; /* wait for 500ms to stabilize main supply */
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		watchdog0 = &wdt31;
		i2c-controller = &i2c21;
		modem-uart = &uart00;
		battery = &npm1300_charger;
		modem = &modem;
	};
};

&gpio1 {
	modem-reset {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	modem-powerkey {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpio2 {
	modem_uart_switch: modem-uart-switch {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&uart20 {
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart00 {
	status = "okay";
	current-speed = <115200>;
	hw-flow-control;
	pinctrl-0 = <&uart00_default>;
	pinctrl-1 = <&uart00_sleep>;
	pinctrl-names = "default", "sleep";

	modem: modem {
		compatible = "nordic,nrf93m1";
		power-domains = <&modem_dcdc>;
		mdm-power-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		mdm-reset-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		mdm-dtr-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
		mdm-ring-gpios = <&gpio1 30 GPIO_ACTIVE_LOW>;
		mdm-status-gpios = <&gpio1 29 GPIO_ACTIVE_HIGH>;
	};
};

&i2c21 {
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,concat-buf-size = <256>;
	status = "okay";

	pmic_main: npm1300@6b {
		compatible = "nordic,npm1300";
		status = "okay";
		reg = <0x6b>;

		regulators {
			compatible = "nordic,npm1300-regulator";
			status = "okay";

			/* Main 1.8 V regulator */
			vdd_nrf: BUCK1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			vdd_dbgr: BUCK2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			/* LDO1 is used for powering the LEDs and level shifters */
			ldo1_3v3: LDO1 {
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
				regulator-allowed-modes = <NPM13XX_LDSW_MODE_LDO>;
				regulator-init-microvolt = <3300000>;
				regulator-boot-on;
			};
		};

		npm1300_charger: charger {
			compatible = "nordic,npm1300-charger";
			status = "okay";
			vbus-limit-microamp = <1500000>;
			/* Battery specs from LiPol LP803448 datasheet (Dwg. nr. FD_3245_70) */
			term-microvolt = <4200000>;
			current-microamp = <675000>; /* 0.5C charging current */
			dischg-limit-microamp = <1000000>; /* Maximum value for PMIC */
			thermistor-cold-millidegrees = <0>;
			thermistor-cool-millidegrees = <0>;
			thermistor-warm-millidegrees = <45000>;
			thermistor-hot-millidegrees = <45000>;
			thermistor-ohms = <10000>;
			thermistor-beta = <3435>;
			charging-enable;
		};
	};
};

/*
 * The bus is shared between the external flash (CS index 0) and the pin header
 * (CS index 1). Devices on the header use reg = <1>.
 */
header_spi: &spi22 {
	status = "okay";
	cs-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>,
		   <&gpio1 23 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi22_default>;
	pinctrl-1 = <&spi22_sleep>;
	pinctrl-names = "default", "sleep";

	mx25r64: mx25r6435f@0 {
		compatible = "jedec,spi-nor";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <8000000>;
		jedec-id = [c2 28 17];
		sfdp-bfp = [e5 20 f1 ff ff ff ff 03 44 eb 08 6b 08 3b 04 bb
			    ee ff ff ff ff ff 00 ff ff ff 00 ff 0c 20 0f 52
			    10 d8 00 ff 23 72 f5 00 82 ed 04 cc 44 83 48 44
			    30 b0 30 b0 f7 c4 d5 5c 00 be 29 ff f0 d0 ff ff];
		size = <67108864>;
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
		reset-gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
	};
};
